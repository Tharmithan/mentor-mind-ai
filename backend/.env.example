# Database — SQLAlchemy async URL
# Quick local dev (no Docker): sqlite+aiosqlite:///./mentormind.db
# Docker Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/mentormind
# Supabase: copy URI from Settings → Database, use postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./mentormind.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=MentorMind AI
DEBUG=true

# OpenAI (optional — enables LLM chat, interview coach, insights)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Email reports (optional — Week 7 Day 4)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# REPORT_EMAIL_FROM=reports@mentormind.ai
# REPORT_EMAIL_TO=student@example.com

# MLOps (optional — Week 7 Day 5)
# MLFLOW_TRACKING_URI=file:../ml-models/mlflow/mlruns
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLOPS_RUN_TRAINING=1

# Production (Week 8 · Day 1 — Railway / Render)
# ML_MODELS_DIR=/app/ml-models
# AUTO_CREATE_TABLES=0
# Supabase: use postgresql+asyncpg://... pooler URL (port 6543)
# CORS_ORIGINS=https://your-app.vercel.app
