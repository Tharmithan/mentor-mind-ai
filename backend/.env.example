# Database — use postgresql+asyncpg:// for SQLAlchemy async
# Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/mentormind
# Supabase: copy URI from Settings → Database, replace postgresql:// with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mentormind

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000

# App
APP_NAME=MentorMind AI
DEBUG=true
