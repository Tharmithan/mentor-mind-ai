# =============================================================================
# MentorMind AI — Production Environment Template (Week 8 · Day 1)
# Copy values into Railway / Render / Vercel dashboards — never commit secrets.
# =============================================================================

# --- Supabase (Database) ---
# Supabase → Settings → Database → Connection string → URI
# Use Transaction pooler (port 6543) for serverless backends:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Railway / Render (Backend) ---
# DATABASE_URL=<from Supabase>
# JWT_SECRET=<openssl rand -hex 32>
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# DEBUG=false
# ML_MODELS_DIR=/app/ml-models
# AUTO_CREATE_TABLES=0
# OPENAI_API_KEY=sk-...   (optional)

# --- Vercel (Frontend) ---
# Root Directory: frontend
# API_PROXY_URL=https://your-api.railway.app
# NEXT_PUBLIC_APP_NAME=MentorMind AI
# (Optional direct API — skips rewrite proxy:)
# NEXT_PUBLIC_API_URL=https://your-api.railway.app
